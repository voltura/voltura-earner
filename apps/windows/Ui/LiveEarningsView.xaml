<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:VolturaEarner.Ui" x:Class="VolturaEarner.Ui.LiveEarningsView">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="StartOptionsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="BorderThickness" Value="1,1,1,1"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderThickness" Value="2"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{ui:Loc NETEARNINGS}" Style="{StaticResource Caption}"/>
        <TextBlock x:Name="NetEarnings" Text="0.00 USD" FontSize="36" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <TextBlock x:Name="GrossEarnings" Style="{StaticResource Caption}"/>
        <Separator Height="1" Margin="0,12"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{ui:Loc TIMEWORKED}" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="WorkedTime" Text="00:00:00" FontSize="28" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{ui:Loc OVERTIME}" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="Overtime" Text="00:00:00" FontSize="28" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="OvertimePay" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>
        <ProgressBar x:Name="DayProgress" Minimum="0" Maximum="100" Height="8" Margin="0,12,0,8"/>
        <TextBlock x:Name="TargetText" Style="{StaticResource Caption}"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{ui:Loc Task}" FontWeight="SemiBold"/>
        <ComboBox x:Name="TaskChoice" Margin="0,10,0,14" MinHeight="38" AutomationProperties.Name="{ui:Loc ActiveTask}" SelectionChanged="TaskChanged"/>
        <WrapPanel>
          <Grid x:Name="StartSplit" Width="180" Margin="0,0,10,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="StartPause" Content="{ui:Loc Start}" MinWidth="0" Tag="toggle" ui:ButtonIcon.Glyph="" Click="ActionClick">
              <Button.Resources>
                <CornerRadius x:Key="ButtonCornerRadius">8,0,0,8</CornerRadius>
              </Button.Resources>
            </Button>
            <Button x:Name="StartOptions" Grid.Column="1" Style="{StaticResource StartOptionsButton}" MinWidth="0" Padding="0" Click="StartOptionsClick" ContextMenuOpening="StartMenuOpening" ToolTip="{ui:Loc StartOptions}" AutomationProperties.Name="{ui:Loc StartOptions}">
              <Button.Content>
                <Grid Width="16" Height="16">
                  <Path Data="M2,8 L14,8 M8,2 L8,14" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.3"/>
                </Grid>
              </Button.Content>
              <Button.Resources>
                <CornerRadius x:Key="ButtonCornerRadius">0,8,8,0</CornerRadius>
              </Button.Resources>
              <Button.ContextMenu>
                <ContextMenu x:Name="StartMenu" Style="{StaticResource StartMenu}" Placement="Bottom" Closed="StartMenuClosed">
                  <MenuItem x:Name="StartOvertimeItem" Style="{StaticResource StartMenuItem}" Header="{ui:Loc StartOvertime}" Tag="start-overtime" Click="StartModeClick" ToolTipService.ShowOnDisabled="True">
                    <MenuItem.Icon>
                      <Grid Width="16" Height="16">
                        <Ellipse Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.3" Margin="1"/>
                        <Path Data="M8,4 L8,8 L11,10" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.3"/>
                      </Grid>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Style="{StaticResource StartMenuItem}" Header="{ui:Loc StartRegular}" Tag="start-regular" Click="StartModeClick">
                    <MenuItem.Icon>
                      <Grid Width="16" Height="16">
                        <Path Data="M2,1 L14,8 L2,15 Z" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                      </Grid>
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </Grid>
          <Button Content="{ui:Loc ManageTasks}" MinWidth="160" Width="Auto" Tag="tasks" ui:ButtonIcon.Glyph="" Click="ActionClick" Margin="0,0,0,8"/>
        </WrapPanel>
        <TextBlock x:Name="PersistenceNote" Style="{StaticResource Caption}" Text="{ui:Loc AutoSaveOn}"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
