<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Company>Voltura AB</Company>
    <Authors>Voltura AB</Authors>
    <Product>Voltura Earner</Product>
    <Copyright>Copyright (c) 2026 Voltura AB</Copyright>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</Version>
  </PropertyGroup>
</Project>
