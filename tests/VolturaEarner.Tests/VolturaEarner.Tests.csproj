<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../apps/windows/App.xaml" Link="UiTestApp.xaml" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="../../installer/languages.nsh" Link="InstallerLanguages.nsh" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="../../apps/windows/**/*.cs;../../apps/windows/**/*.xaml" Exclude="../../apps/windows/obj/**;../../apps/windows/bin/**" Link="LocalizationSource/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0"/>
    <PackageReference Include="xunit.v3" Version="4.0.1"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0"/>
    <ProjectReference Include="../../apps/windows/VolturaEarner.csproj"/>
  </ItemGroup>
</Project>
